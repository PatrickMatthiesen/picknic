{
    "private": true,
    "packageManager": "bun@1.3.7",
    "scripts": {
        "dev": "aspire start",
        "stop": "aspire stop",
        "check": "bun run --cwd web check",
        "test:ai": "bun run --cwd web test:ai",
        "dockercompose:up": "cd apphost/aspire-output && docker compose up -d",
        "dockercompose:down": "cd apphost/aspire-output && docker compose down",
        "dockercompose:logs": "cd apphost/aspire-output && docker compose logs -f"
    }
}
