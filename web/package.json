{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "test:ai": "bun run evals/recipe-parser.live.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "bun run prisma:generate && bun run typecheck && bun run test && bun run lint && bun run build && bun run audit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "audit": "bun audit --audit-level=high",
    "test:integration": "bun test ./tests/meal-planning.database.ts"
  },
  "dependencies": {
    "@dnd-kit/react": "0.5.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.2",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.223.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.2",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/otel": "2.3.0",
    "@workos-inc/authkit-nextjs": "4.6.3",
    "@workos-inc/node": "12.4.0",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "openai": "7.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "workos": "0.24.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "effect": "3.22.1"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
